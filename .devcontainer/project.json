{
  "name": "devcontainer",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node .devcontainer/scripts/lifecycle.mjs build", "cwd": "." }
    },
    "up": {
      "executor": "nx:run-commands",
      "options": { "command": "node .devcontainer/scripts/lifecycle.mjs up", "cwd": "." }
    },
    "exec": {
      "executor": "nx:run-commands",
      "options": { "command": "node .devcontainer/scripts/lifecycle.mjs exec", "cwd": ".", "forwardAllArgs": true }
    },
    "doctor": {
      "executor": "nx:run-commands",
      "options": { "command": "node .devcontainer/scripts/lifecycle.mjs doctor", "cwd": "." }
    },
    "scripts-test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test .devcontainer/test/*.test.mjs", "cwd": "." }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["scripts-test"],
      "options": { "command": "node -e \"console.log('Devcontainer script contracts passed')\"" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node .devcontainer/scripts/lifecycle.mjs test", "cwd": "." }
    },
    "down": {
      "executor": "nx:run-commands",
      "options": { "command": "node .devcontainer/scripts/lifecycle.mjs down", "cwd": ".", "forwardAllArgs": true }
    }
  }
}
