{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["sdk", "horizon-store"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npm run build --workspace=packages/app",
        "cwd": "."
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dev/run-checks.mjs app",
        "cwd": "."
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npm run test:e2e --workspace=packages/app",
        "cwd": ".",
        "forwardAllArgs": true
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["test-unit"],
      "options": {
        "command": "node -e \"console.log('Application checks passed')\""
      }
    }
  }
}
