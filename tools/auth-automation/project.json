{
  "name": "auth-automation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "status": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/auth-automation/src/cli.mjs status", "cwd": ".", "forwardAllArgs": true }
    },
    "login": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/auth-automation/src/cli.mjs login", "cwd": ".", "forwardAllArgs": true }
    },
    "browser-install": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/auth-automation/src/cli.mjs browser-install", "cwd": "." }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "node node_modules/typescript/bin/tsc --project tools/auth-automation/tsconfig.json", "cwd": "." }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test tools/auth-automation/test/*.test.mjs", "cwd": "." }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck", "test"],
      "options": { "command": "node -e \"console.log('Auth automation contracts passed; live identity approval is separate')\"" }
    }
  }
}
